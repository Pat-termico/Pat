{
  "name": "dashboard-arduino-scada",
  "private": true,
  "version": "1.1.9",
  "description": "Dashboard industrial premium em tempo real para Arduino UNO (Electron + React + Tailwind + Serial + Socket.IO).",
  "main": "electron/main.cjs",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "npx concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npx vite --strictPort false\" \"node electron\\wait-for-vite.cjs\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run lint && npm run build:renderer && electron-builder --win",
    "build:linux": "npm run lint && npm run build:renderer && electron-builder --linux",
    "build:all": "npm run lint && npm run build:renderer && electron-builder --win --linux",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.cjs",
    "test:watch": "node --test --watch tests/*.cjs"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.pattermico.dashboard.arduino",
    "productName": "Dashboard Arduino",
    "icon": "build/Logo_web-site.png",
    "asar": true,
    "npmRebuild": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Pat-termico",
        "repo": "Pat",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/Logo_web-site.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "synopsis": "Dashboard industrial em tempo real para Arduino UNO (termopares Tipo K + BME680)",
      "description": "Sistema profissional de monitoramento industrial conectado fisicamente a um Arduino UNO via USB/Serial: 3 termopares Tipo K (MAX6675) e sensor ambiental BME680 (temperatura, umidade, pressao real e VOC). Historico, exportacao CSV Excel compat, backup automatico e atualizacao automatica via GitHub Releases.",
      "vendor": "Pat Térmico",
      "maintainer": "Pat Térmico <contato@pattermico.com>"
    },
    "deb": {
      "packageCategory": "sci",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "appImage": {
      "license": "MIT",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "${productName}-${version}.${arch}.${ext}",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ]
    },
    "pacman": {
      "conflicts": [
        "dashboard-arduino-bin"
      ],
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "xdg-utils",
        "at-spi2-core"
      ]
    }
  }
}
